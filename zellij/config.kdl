// Zellij configuration
// See: https://zellij.dev/documentation/configuration.html

// Keybindings
keybinds {
  shared_except "locked" {
    // unbind all alt-based pane navigation
    unbind "Alt Left"
    unbind "Alt Right"
    unbind "Alt Up"
    unbind "Alt Down"
    unbind "Alt h"
    unbind "Alt l"
    unbind "Alt j"
    unbind "Alt k"
  }

  normal {
    unbind "Ctrl g"

    // control planes via ctrl-f and directly
    unbind "Ctrl p"
    bind "Ctrl f" {
      SwitchToMode "pane";
    }

    // session management via ctrl-s
    unbind "Ctrl o"
    bind "Ctrl s" {
      SwitchToMode "session";
    }

    // unbind alt + arrow keys for pane focus
    unbind "Alt Left"
    unbind "Alt Right"
    unbind "Alt Up"
    unbind "Alt Down"
    unbind "Alt h"
    unbind "Alt l"
    unbind "Alt j"
    unbind "Alt k"
  }

  pane {
    bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
    bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
    bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
    bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
    bind "[" { MovePane "Left"; SwitchToMode "Normal"; }
    bind "]" { MovePane "Right"; SwitchToMode "Normal"; }
    bind "H" { NewPane "Left"; SwitchToMode "Normal"; }
    bind "L" { NewPane "Right"; SwitchToMode "Normal"; }
    bind "J" { NewPane "Down"; SwitchToMode "Normal"; }
    bind "K" { NewPane "Up"; SwitchToMode "Normal"; }
    unbind "x"
    bind "q" { CloseFocus; SwitchToMode "Normal"; }
    bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
  }
}

// Theme configuration
theme "onedark"

// UI configuration
pane_frames true
// zellij 0.45 changed the defaults to a title-only frame and a compact list for stacked panes;
// restore the classic look with full borders around each pane
pane_frame_style "full"
stacked_pane_list false
simplified_ui true

// Default layout
// TODO let's start using this once we have a better understanding what we want
// default_layout "default"

// Default shell
default_shell "fish"

// Default editor
// scrollback_editor "nvim"

// Mouse mode
mouse_mode true
mouse_hover_effects false

// Scrollback buffer size
scroll_buffer_size 100000

// if a session with the specified name already exists, attach to it
attach_to_session true

// Plugins
load_plugins {
  "file:~/.config//zellij/plugins/zellij-attention.wasm"
}
